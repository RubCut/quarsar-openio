<?xml version="1.0" encoding="utf-8"?>
<!-- Material Design 3 theme: DayNight, no action bar, violet baseline palette. -->
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md3_primary</item>
        <item name="colorPrimaryDark">@color/md3_surface</item>
        <item name="colorAccent">@color/md3_primary</item>
        <item name="android:windowBackground">@color/md3_surface</item>
        <item name="android:statusBarColor">@color/md3_surface</item>
        <item name="android:navigationBarColor">@color/md3_surface</item>
        <item name="android:windowLightStatusBar">@bool/md3_light_status</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="StatusRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textColor">@color/md3_on_surface</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="AppButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">normal</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="AppButton.Filled">
        <item name="android:background">@drawable/btn_filled</item>
        <item name="android:textColor">@color/md3_on_primary</item>
    </style>

    <style name="AppButton.Tonal">
        <item name="android:background">@drawable/btn_tonal</item>
        <item name="android:textColor">@color/md3_on_secondary_container</item>
    </style>

    <style name="AppButton.Outlined">
        <item name="android:background">@drawable/btn_outlined</item>
        <item name="android:textColor">@color/md3_primary</item>
    </style>

    <style name="AppButton.Error">
        <item name="android:background">@drawable/btn_outlined</item>
        <item name="android:textColor">@color/md3_error</item>
    </style>

    <style name="SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/md3_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>
</resources>
