<?xml version="1.0" encoding="utf-8"?>
<!-- MD3 outlined button: 1px outline, full-round shape, state layer. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/md3_primary">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/md3_surface" />
            <stroke android:width="1dp" android:color="@color/md3_outline" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</ripple>
